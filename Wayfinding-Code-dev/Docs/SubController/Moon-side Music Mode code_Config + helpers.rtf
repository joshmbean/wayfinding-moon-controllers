uint8_t cellAddresses[NUM_CELLS];\
\
// ================== HELPER FUNCTIONS ==================\
\
// Helper to send a NoteEvent to the Moth (to implement with ESP-NOW or other link).\
// Scott: implement this to actually call esp_now_send() with the Moth's MAC.\
