\
// Scale a raw pressure (0-255-ish) to a MIDI velocity (0-127).\
// Uses globalConfig.pressThreshold and globalConfig.maxThreshold.\
uint8_t scalePressureToVelocity(uint8_t pressure) \{\
  uint8_t pressThr = globalConfig.pressThreshold;\
  uint8_t maxThr   = globalConfig.maxThreshold; // upper clamp\
\
  if (pressure <= pressThr) return 0;\
  if (pressure >= maxThr)   pressure = maxThr;\
\
  uint8_t range = (maxThr > pressThr) ? (maxThr - pressThr) : 1;\
  uint8_t scaled = (uint16_t)(pressure - pressThr) * 127 / range;\
  if (scaled > 127) scaled = 127;\
  if (scaled < 1)   scaled = 1;\
  return scaled;\
\}\
\
// Scale pressure to LED brightness percentage between BASE and MAX.\
uint8_t scalePressureToBrightnessPercent(uint8_t pressure) \{\
  if (pressure == 0) return MUSIC_BASE_BRIGHTNESS_PERCENT;\
\
  uint8_t pressThr = globalConfig.pressThreshold;\
  uint8_t maxThr   = globalConfig.maxThreshold;\
\
  if (pressure <= pressThr) return MUSIC_BASE_BRIGHTNESS_PERCENT;\
  if (pressure >= maxThr)   pressure = maxThr;\
\
  uint8_t range = (maxThr > pressThr) ? (maxThr - pressThr) : 1;\
  uint8_t span  = MUSIC_MAX_BRIGHTNESS_PERCENT - MUSIC_BASE_BRIGHTNESS_PERCENT;\
\
  uint8_t scaled = (uint16_t)(pressure - pressThr) * span / range;\
  uint8_t result = MUSIC_BASE_BRIGHTNESS_PERCENT + scaled;\
\
  if (result > MUSIC_MAX_BRIGHTNESS_PERCENT) result = MUSIC_MAX_BRIGHTNESS_PERCENT;\
  return result;\
\}\
\
// Build a 24-bit color for a cell at a given brightness.\
uint32_t makeColorForCell(uint8_t cellIndex, uint8_t brightnessPercent) \{\
  uint8_t ch = cellMidiChannel[cellIndex];\
\
  const uint8_t *baseColor;\
  if      (ch == 1)  baseColor = MUSIC_CH1_COLOR;\
  else if (ch == 2)  baseColor = MUSIC_CH2_COLOR;\
  else if (ch == 3)  baseColor = MUSIC_CH3_COLOR;\
  else if (ch == 10) baseColor = MUSIC_CH10_COLOR;\
  else               baseColor = MUSIC_CH1_COLOR; // fallback\
\
  uint8_t r = (uint16_t)baseColor[0] * brightnessPercent / 100;\
  uint8_t g = (uint16_t)baseColor[1] * brightnessPercent / 100;\
  uint8_t b = (uint16_t)baseColor[2] * brightnessPercent / 100;\
\
  // Use Adafruit_NeoPixel helper for correct GRB order\
  return strip.Color(r, g, b);\
\}\
\
// Set LED colour for a given cellIndex at given brightness percentage.\
void setMusicCellLed(uint8_t cellIndex, uint8_t brightnessPercent) \{\
  if (cellIndex >= NUM_CELLS) return;\
\
  uint8_t addr = cellAddresses[cellIndex];\
  if (addr == 0xFF) \{\
    // Address not configured yet\
    return;\
  \}\
\
  uint32_t col = makeColorForCell(cellIndex, brightnessPercent);\
  I2C_send_col(addr, col);\
\}\
\
// Initialize state when we first enter Music mode\
void MusicMode_init() \{\
  for (uint8_t i = 0; i < NUM_CELLS; i++) \{\
    musicCellPressed[i]        = false;\
    musicCellLastVelocity[i]   = 0;\
    musicCellLastPressMillis[i]= 0;\
    musicDrumFading[i]         = false;\
    musicDrumFadeStartMillis[i]= 0;\
\
    // Idle LED state per channel\
    uint8_t ch = cellMidiChannel[i];\
    if (ch == 1 || ch == 2 || ch == 3) \{\
      setMusicCellLed(i, MUSIC_BASE_BRIGHTNESS_PERCENT);\
    \} else if (ch == 10) \{\
      // Drums: start off (or very dim if you prefer)\
      setMusicCellLed(i, 0);\
    \}\
  \}\
  lastMusicSampleMillis = millis();\
\}\
}